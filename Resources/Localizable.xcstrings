        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los pasaportes y escaneos de este viaje se eliminan el %@, %lld día después de exportar por primera vez la lista de tripulantes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
