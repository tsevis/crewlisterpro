    "Archiving keeps the charter and its sealed scans. Deleting erases %lld encrypted documents from %@, and cannot be undone.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Beim Archivieren bleiben der Charter und seine versiegelten Scans erhalten. Beim Löschen wird %lld verschlüsseltes Dokument von %@ gelöscht; dies kann nicht widerrufen werden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Beim Archivieren bleiben der Charter und seine versiegelten Scans erhalten. Beim Löschen werden %lld verschlüsselte Dokumente von %@ gelöscht; dies kann nicht widerrufen werden."
                }
