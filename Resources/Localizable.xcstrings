    "New trips": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Törns"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νέα ταξίδια"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes nuevos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelles croisières"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuovi viaggi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові рейси"
          }
        }
      }
    },
    "New trips already run %@ to %@. Moving the departure moves the return with it and keeps the charter the same length; pick a return date to override that. Boarding time and port go on the passenger manifest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Törns laufen bereits von %@ bis %@. Wird die Abfahrt verschoben, verschiebt sich die Rückkehr mit und der Charter behält seine Dauer; wählen Sie ein Rückkehrdatum, um dies zu übersteuern. Einschiffungszeit und -hafen stehen auf der Passagierliste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα νέα ταξίδια ήδη διαρκούν από %@ έως %@. Η μετακίνηση της αναχώρησης μετακινεί μαζί και την επιστροφή και κρατά τη ναύλωση στην ίδια διάρκεια· επιλέξτε ημερομηνία επιστροφής για να το παρακάμψετε. Η ώρα και το λιμάνι επιβίβασης μπαίνουν στην κατάσταση επιβατών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los viajes nuevos ya van del %@ al %@. Al mover la salida, el regreso se mueve con ella y el chárter mantiene la misma duración; elige una fecha de regreso para cambiarlo. La hora y el puerto de embarque figuran en el manifiesto de pasajeros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles croisières vont déjà du %@ au %@. Déplacer le départ déplace le retour avec lui et conserve la durée du charter ; choisissez une date de retour pour passer outre. L'heure et le port d'embarquement figurent sur le manifeste des passagers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi viaggi vanno già da %@ a %@. Spostando la partenza si sposta anche il ritorno e il charter mantiene la stessa durata; scegli una data di ritorno per modificarla. Ora e porto d'imbarco compaiono sul manifesto passeggeri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові рейси вже тривають: %@ — %@. Зміна дати відправлення переносить і дату повернення, зберігаючи тривалість чартеру; щоб змінити це, виберіть дату повернення. Час і порт посадки вказуються в списку пасажирів."
          }
        }
      }
    },
    "New trips already run %lld days from a %@. Moving the departure moves the return with it and keeps the charter the same length; pick a return date to override that. Boarding time and port go on the passenger manifest.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Neue Törns laufen bereits %lld Tag ab einem %@. Wird die Abfahrt verschoben, verschiebt sich die Rückkehr mit und der Charter behält seine Dauer; wählen Sie ein Rückkehrdatum, um dies zu übersteuern. Einschiffungszeit und -hafen stehen auf der Passagierliste."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Neue Törns laufen bereits %lld Tage ab einem %@. Wird die Abfahrt verschoben, verschiebt sich die Rückkehr mit und der Charter behält seine Dauer; wählen Sie ein Rückkehrdatum, um dies zu übersteuern. Einschiffungszeit und -hafen stehen auf der Passagierliste."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Τα νέα ταξίδια ήδη διαρκούν %lld ημέρα, με αναχώρηση ημέρα %@. Η μετακίνηση της αναχώρησης μετακινεί μαζί και την επιστροφή και κρατά τη ναύλωση στην ίδια διάρκεια· επιλέξτε ημερομηνία επιστροφής για να το παρακάμψετε. Η ώρα και το λιμάνι επιβίβασης μπαίνουν στην κατάσταση επιβατών."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Τα νέα ταξίδια ήδη διαρκούν %lld ημέρες, με αναχώρηση ημέρα %@. Η μετακίνηση της αναχώρησης μετακινεί μαζί και την επιστροφή και κρατά τη ναύλωση στην ίδια διάρκεια· επιλέξτε ημερομηνία επιστροφής για να το παρακάμψετε. Η ώρα και το λιμάνι επιβίβασης μπαίνουν στην κατάσταση επιβατών."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "New trips already run %lld day from a %@. Moving the departure moves the return with it and keeps the charter the same length; pick a return date to override that. Boarding time and port go on the passenger manifest."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "New trips already run %lld days from a %@. Moving the departure moves the return with it and keeps the charter the same length; pick a return date to override that. Boarding time and port go on the passenger manifest."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los viajes nuevos ya duran %lld día a partir de un %@. Al mover la salida, el regreso se mueve con ella y el chárter mantiene la misma duración; elige una fecha de regreso para cambiarlo. La hora y el puerto de embarque figuran en el manifiesto de pasajeros."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los viajes nuevos ya duran %lld días a partir de un %@. Al mover la salida, el regreso se mueve con ella y el chárter mantiene la misma duración; elige una fecha de regreso para cambiarlo. La hora y el puerto de embarque figuran en el manifiesto de pasajeros."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
