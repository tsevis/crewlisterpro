{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is a digit — a nationality has none. Check it against the document.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist eine Ziffer – eine Staatsangehörigkeit enthält keine. Prüfen Sie sie anhand des Dokuments."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι ψηφίο — μια υπηκοότητα δεν έχει ψηφία. Ελέγξτε την με το έγγραφο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es un dígito y una nacionalidad no tiene ninguno. Compruébalo con el documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un chiffre — une nationalité n'en contient pas. Vérifiez-la sur le document."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è una cifra: una nazionalità non ne contiene. Verificala sul documento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — цифра, а в громадянстві цифр немає. Звірте з документом."
          }
        }
      }
    },
    "%@ (retired)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (ausgemustert)"
          }
        },
