              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ · %lld човнів"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ · %lld човен"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ · %lld човна"
                }
              }
            }
          }
        }
      }
    },
    "%@ — not reachable, exports will ask": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — μη προσβάσιμος φάκελος, κάθε εξαγωγή θα ρωτά"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — недоступна, під час експорту буде запит"
          }
        }
      }
    },
    "%@'s scan could not be read from the crew library, so they were not added: %@": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση για το άτομο %@ δεν ήταν δυνατό να διαβαστεί από τη βιβλιοθήκη πληρώματος, οπότε δεν προστέθηκε: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скан особи %1$@ не вдалося прочитати з бібліотеки екіпажу, тому її не додано: %2$@"
          }
        }
      }
    },
    "%@. Opens %@'s website.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ανοίγει τον ιστότοπο: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Відкриває вебсайт %2$@."
          }
        }
      }
    },
    "%@: %@ still unconfirmed.": {
      "comment": "A document's file name, then the field labels not yet confirmed.",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ — δεν έχουν επιβεβαιωθεί ακόμη."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ще не підтверджено — %2$@."
          }
        }
      }
    },
