    "Read by the local model, not from the machine-readable zone. Check it character by character.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom lokalen Modell gelesen, nicht aus der maschinenlesbaren Zone. Prüfen Sie es Zeichen für Zeichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστηκε από το τοπικό μοντέλο, όχι από τη ζώνη μηχανικής ανάγνωσης. Ελέγξτε το χαρακτήρα προς χαρακτήρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído por el modelo local, no de la zona de lectura mecánica. Revísalo carácter a carácter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu par le modèle local, pas depuis la zone de lecture automatique. Vérifiez-le caractère par caractère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dal modello locale, non dalla zona a lettura ottica. Verificalo carattere per carattere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано локальною моделлю, а не з машинозчитуваної зони. Перевірте посимвольно."
          }
        }
      }
    },
