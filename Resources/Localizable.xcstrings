            "state": "translated",
            "value": "Base de datos cifrada, originales sellados y versiones anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Base de données chiffrée, originaux scellés et versions précédentes"
          }
        },
        "it": {
