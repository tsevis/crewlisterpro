{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is a digit — a nationality has none. Check it against the document.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι ψηφίο — μια υπηκοότητα δεν έχει ψηφία. Ελέγξτε την με το έγγραφο."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — цифра, а в громадянстві цифр немає. Звірте з документом."
          }
        }
      }
    },
    "%@ (retired)": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (αποσυρμένο)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (виведена з флоту)"
          }
        }
      }
    },
    "%@ and %@": {
      "comment": "Joins the files an export writes: the others, comma-separated, then the last one.",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ και %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ і %@"
          }
        }
      }
    },
    "%@ confirmed": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: επιβεβαιώθηκε"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: підтверджено"
          }
        }
      }
    },
    "%@ could not be read: %@": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο %@ δεν ήταν δυνατό να διαβαστεί: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати %@: %@"
          }
        }
      }
    },
    "%@ is %lld MB, which is larger than a document this app will take.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι %lld MB, μεγαλύτερο από όσο δέχεται αυτή η εφαρμογή για ένα έγγραφο."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ має розмір %lld МБ — це завеликий документ для цієї програми."
          }
        }
      }
    },
    "%@ is already on this trip.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο %@ βρίσκεται ήδη σε αυτό το ταξίδι."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже є в цьому рейсі."
          }
        }
      }
    },
    "%@ is not an image or a PDF.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν είναι εικόνα ή PDF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ не є зображенням чи PDF."
          }
        }
      }
    },
    "%@ is rejected.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ απορρίφθηκε."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відхилено."
          }
        }
      }
    },
    "%@ is removed from the fleet, and so are the %lld trips made for it and their %lld encrypted documents. The passport scans are erased from this Mac and cannot be recovered.\n\nTo take a yacht out of the fleet while keeping its past charters, retire it instead.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ αφαιρείται από τον στόλο, μαζί με τα ταξίδια που έγιναν με αυτό (%lld) και τα κρυπτογραφημένα έγγραφά τους (%lld). Οι σαρώσεις των διαβατηρίων σβήνονται από αυτό το Mac και δεν μπορούν να ανακτηθούν.\n\nΓια να βγάλετε ένα σκάφος από τον στόλο κρατώντας τις παλαιότερες ναυλώσεις του, αποσύρετέ το."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхту %1$@ буде видалено з флоту разом із рейсами, створеними для неї (%2$lld), та їхніми зашифрованими документами (%3$lld). Скани паспортів буде стерто з цього Mac, і відновити їх неможливо.\n\nЩоб прибрати яхту зі списку, зберігши її минулі чартери, виведіть її з флоту."
          }
        }
      }
    },
    "%@ is removed from the fleet, and so are the %lld trips made for it and their no documents. The passport scans are erased from this Mac and cannot be recovered.\n\nTo take a yacht out of the fleet while keeping its past charters, retire it instead.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ αφαιρείται από τον στόλο, μαζί με τα ταξίδια που έγιναν με αυτό (%lld), τα οποία δεν έχουν έγγραφα. Οι σαρώσεις των διαβατηρίων σβήνονται από αυτό το Mac και δεν μπορούν να ανακτηθούν.\n\nΓια να βγάλετε ένα σκάφος από τον στόλο κρατώντας τις παλαιότερες ναυλώσεις του, αποσύρετέ το."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхту %1$@ буде видалено з флоту разом із рейсами, створеними для неї (%2$lld), у яких немає документів. Скани паспортів буде стерто з цього Mac, і відновити їх неможливо.\n\nЩоб прибрати яхту зі списку, зберігши її минулі чартери, виведіть її з флоту."
          }
        }
      }
    },
    "%@ is removed from the fleet. No trip uses it, so no crew list changes.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ αφαιρείται από τον στόλο. Κανένα ταξίδι δεν το χρησιμοποιεί, οπότε καμία κατάσταση πληρώματος δεν αλλάζει."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхту %@ буде видалено з флоту. Жоден рейс її не використовує, тож жоден список екіпажу не зміниться."
          }
        }
      }
    },
    "%@ leaves the library and the library's copy of their scan is erased from this Mac.\n\nTrips they are already on keep their own copies and are not touched.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο %@ αφαιρείται από τη βιβλιοθήκη και το αντίγραφο της σάρωσής του που κρατά η βιβλιοθήκη σβήνεται από αυτό το Mac.\n\nΤα ταξίδια στα οποία συμμετέχει ήδη κρατούν τα δικά τους αντίγραφα και δεν επηρεάζονται."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ буде вилучено з бібліотеки, а бібліотечну копію скану — стерто з цього Mac.\n\nРейси, до яких цю особу вже додано, зберігають власні копії й не змінюються."
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Download progress: bytes received, then bytes expected.",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ από %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ з %@"
          }
        }
      }
    },
    "%@ was kept, but their scan could not be copied into the library: %@": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο %@ διατηρήθηκε, αλλά η σάρωσή του δεν ήταν δυνατό να αντιγραφεί στη βιβλιοθήκη: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані особи %1$@ збережено, але її скан не вдалося скопіювати до бібліотеки: %2$@"
          }
        }
      }
    },
    "%@ was shared to CrewListr Pro but could not be read: %@": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ κοινοποιήθηκε στο CrewListr Pro αλλά δεν ήταν δυνατό να διαβαστεί: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %1$@ надіслано до CrewListr Pro, але його не вдалося прочитати: %2$@"
          }
        }
      }
    },
    "%@ · %lld boats": {
      "localizations": {
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ · %lld σκάφος"
                }
