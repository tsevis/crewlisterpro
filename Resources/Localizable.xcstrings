            "state": "translated",
            "value": "Διορθώστε αυτή την τιμή πριν την επιβεβαιώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige este valor antes de confirmarlo."
          }
        },
        "fr": {
