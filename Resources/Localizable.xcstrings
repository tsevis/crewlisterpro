        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Решту ваших даних відкрито як звичайно. Попередня версія може бути доступна в розділі «Попередні версії»."
          }
        }
      }
    },
    "The scanned document. Open it full screen.": {
