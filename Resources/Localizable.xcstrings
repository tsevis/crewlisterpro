        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ και %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ і %@"
          }
        }
      }
    },
    "%@ confirmed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bestätigt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: επιβεβαιώθηκε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confirmado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confirmé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confermato"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: підтверджено"
          }
        }
      }
    },
    "%@ could not be read: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gelesen werden: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο %@ δεν ήταν δυνατό να διαβαστεί: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer %@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire %@ : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere %@: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати %@: %@"
          }
        }
      }
    },
    "%@ is %lld MB, which is larger than a document this app will take.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist %lld MB groß und damit größer als jedes Dokument, das diese App annimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι %lld MB, μεγαλύτερο από όσο δέχεται αυτή η εφαρμογή για ένα έγγραφο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ocupa %lld MB, más de lo que esta app admite para un documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fait %lld Mo, ce qui dépasse la taille de document acceptée par cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pesa %lld MB, più di quanto questa app accetti per un documento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ має розмір %lld МБ — це завеликий документ для цієї програми."
          }
        }
      }
    },
    "%@ is already on this trip.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits auf diesem Törn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο %@ βρίσκεται ήδη σε αυτό το ταξίδι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en este viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fait déjà partie de cette croisière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già in questo viaggio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже є в цьому рейсі."
          }
        }
      }
    },
    "%@ is not an image or a PDF.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist weder ein Bild noch ein PDF."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν είναι εικόνα ή PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es una imagen ni un PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est ni une image ni un PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è un'immagine né un PDF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ не є зображенням чи PDF."
          }
        }
      }
    },
    "%@ is rejected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist abgelehnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ απορρίφθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está rechazado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est rejeté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato rifiutato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відхилено."
          }
        }
      }
    },
    "%@ is removed from the fleet, and so are the %lld trips made for it and their %lld encrypted documents. The passport scans are erased from this Mac and cannot be recovered.\n\nTo take a yacht out of the fleet while keeping its past charters, retire it instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird aus der Flotte entfernt, ebenso die %lld Törns dieser Yacht und ihre %lld verschlüsselten Dokumente. Die Passscans werden von diesem Mac gelöscht und können nicht wiederhergestellt werden.\n\nUm eine Yacht aus der Flotte zu nehmen und ihre früheren Charter zu behalten, mustern Sie sie stattdessen aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ αφαιρείται από τον στόλο, μαζί με τα ταξίδια που έγιναν με αυτό (%lld) και τα κρυπτογραφημένα έγγραφά τους (%lld). Οι σαρώσεις των διαβατηρίων σβήνονται από αυτό το Mac και δεν μπορούν να ανακτηθούν.\n\nΓια να βγάλετε ένα σκάφος από τον στόλο κρατώντας τις παλαιότερες ναυλώσεις του, αποσύρετέ το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se elimina de la flota, junto con los %lld viajes hechos con él y sus %lld documentos cifrados. Los escaneos de pasaportes se borran de este Mac y no se pueden recuperar.\n\nPara sacar un yate de la flota conservando sus chárteres anteriores, retíralo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est retiré de la flotte, ainsi que les %lld croisières créées pour lui et leurs %lld documents chiffrés. Les scans de passeport sont effacés de ce Mac et ne peuvent pas être récupérés.\n\nPour sortir un yacht de la flotte tout en conservant ses charters passés, retirez-le plutôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene rimosso dalla flotta, insieme ai %lld viaggi creati per esso e ai loro %lld documenti crittografati. Le scansioni dei passaporti vengono cancellate da questo Mac e non possono essere recuperate.\n\nPer togliere uno yacht dalla flotta conservandone i charter passati, ritiralo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхту %1$@ буде видалено з флоту разом із рейсами, створеними для неї (%2$lld), та їхніми зашифрованими документами (%3$lld). Скани паспортів буде стерто з цього Mac, і відновити їх неможливо.\n\nЩоб прибрати яхту зі списку, зберігши її минулі чартери, виведіть її з флоту."
          }
        }
      }
    },
    "%@ is removed from the fleet, and so are the %lld trips made for it and their no documents. The passport scans are erased from this Mac and cannot be recovered.\n\nTo take a yacht out of the fleet while keeping its past charters, retire it instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird aus der Flotte entfernt, ebenso die %lld Törns dieser Yacht, die keine Dokumente enthalten. Die Passscans werden von diesem Mac gelöscht und können nicht wiederhergestellt werden.\n\nUm eine Yacht aus der Flotte zu nehmen und ihre früheren Charter zu behalten, mustern Sie sie stattdessen aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ αφαιρείται από τον στόλο, μαζί με τα ταξίδια που έγιναν με αυτό (%lld), τα οποία δεν έχουν έγγραφα. Οι σαρώσεις των διαβατηρίων σβήνονται από αυτό το Mac και δεν μπορούν να ανακτηθούν.\n\nΓια να βγάλετε ένα σκάφος από τον στόλο κρατώντας τις παλαιότερες ναυλώσεις του, αποσύρετέ το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se elimina de la flota, junto con los %lld viajes hechos con él, que no tienen documentos. Los escaneos de pasaportes se borran de este Mac y no se pueden recuperar.\n\nPara sacar un yate de la flota conservando sus chárteres anteriores, retíralo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est retiré de la flotte, ainsi que les %lld croisières créées pour lui, sans aucun document. Les scans de passeport sont effacés de ce Mac et ne peuvent pas être récupérés.\n\nPour sortir un yacht de la flotte tout en conservant ses charters passés, retirez-le plutôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene rimosso dalla flotta, insieme ai %lld viaggi creati per esso, che non hanno documenti. Le scansioni dei passaporti vengono cancellate da questo Mac e non possono essere recuperate.\n\nPer togliere uno yacht dalla flotta conservandone i charter passati, ritiralo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхту %1$@ буде видалено з флоту разом із рейсами, створеними для неї (%2$lld), у яких немає документів. Скани паспортів буде стерто з цього Mac, і відновити їх неможливо.\n\nЩоб прибрати яхту зі списку, зберігши її минулі чартери, виведіть її з флоту."
          }
        }
      }
    },
    "%@ is removed from the fleet. No trip uses it, so no crew list changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird aus der Flotte entfernt. Kein Törn verwendet sie, daher ändert sich keine Crewliste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ αφαιρείται από τον στόλο. Κανένα ταξίδι δεν το χρησιμοποιεί, οπότε καμία κατάσταση πληρώματος δεν αλλάζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se elimina de la flota. Ningún viaje lo usa, así que ninguna lista de tripulantes cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est retiré de la flotte. Aucune croisière ne l'utilise, aucune liste d'équipage ne change donc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene rimosso dalla flotta. Nessun viaggio lo usa, quindi nessuna lista equipaggio cambia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхту %@ буде видалено з флоту. Жоден рейс її не використовує, тож жоден список екіпажу не зміниться."
          }
        }
      }
    },
    "%@ leaves the library and the library's copy of their scan is erased from this Mac.\n\nTrips they are already on keep their own copies and are not touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird aus der Bibliothek entfernt, und die Kopie des Scans in der Bibliothek wird von diesem Mac gelöscht.\n\nTörns, auf denen die Person bereits ist, behalten ihre eigenen Kopien und bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο %@ αφαιρείται από τη βιβλιοθήκη και το αντίγραφο της σάρωσής του που κρατά η βιβλιοθήκη σβήνεται από αυτό το Mac.\n\nΤα ταξίδια στα οποία συμμετέχει ήδη κρατούν τα δικά τους αντίγραφα και δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sale de la biblioteca y la copia de su escaneo que guarda la biblioteca se borra de este Mac.\n\nLos viajes en los que ya figura conservan sus propias copias y no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quitte la bibliothèque et la copie de son scan qu'elle conservait est effacée de ce Mac.\n\nLes croisières auxquelles cette personne participe déjà gardent leurs propres copies et ne sont pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esce dalla libreria e la copia della sua scansione nella libreria viene cancellata da questo Mac.\n\nI viaggi in cui è già presente conservano le proprie copie e non vengono toccati."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ буде вилучено з бібліотеки, а бібліотечну копію скану — стерто з цього Mac.\n\nРейси, до яких цю особу вже додано, зберігають власні копії й не змінюються."
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Download progress: bytes received, then bytes expected.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von %@"
