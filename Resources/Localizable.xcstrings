    "Already kept. Keeping again replaces what the library holds with what is confirmed here now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits aufbewahrt. Erneutes Aufbewahren ersetzt den Inhalt der Bibliothek durch das, was hier jetzt bestätigt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχει ήδη διατηρηθεί. Μια νέα διατήρηση αντικαθιστά ό,τι έχει η βιβλιοθήκη με ό,τι έχει επιβεβαιωθεί εδώ τώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya guardado. Volver a guardarlo sustituye lo que tiene la biblioteca por lo que se ha confirmado aquí ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà conservé. Conserver à nouveau remplace ce que contient la bibliothèque par ce qui est confirmé ici maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già conservato. Conservarlo di nuovo sostituisce ciò che la libreria contiene con ciò che è confermato qui ora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже збережено. Повторне збереження замінить дані в бібліотеці тим, що підтверджено тут зараз."
          }
        }
      }
    },
    "Already saved — nothing has changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gesichert – nichts hat sich geändert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχει ήδη αποθηκευτεί — δεν έχει αλλάξει τίποτα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya guardado: no ha cambiado nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà enregistré — rien n'a changé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già salvato: non è cambiato nulla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже збережено — нічого не змінилося"
          }
        }
      }
    },
    "An email address cannot contain a space.": {
      "localizations": {
        "de": {
