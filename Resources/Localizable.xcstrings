    "No checksum-valid machine-readable zone; every field needs checking against the image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine maschinenlesbare Zone mit gültiger Prüfsumme; jedes Feld muss anhand des Bildes geprüft werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ζώνη μηχανικής ανάγνωσης με έγκυρα ψηφία ελέγχου· κάθε πεδίο πρέπει να ελεγχθεί με την εικόνα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una zona de lectura mecánica con suma de control válida; hay que revisar cada campo con la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
