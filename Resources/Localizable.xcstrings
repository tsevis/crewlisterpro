    "Encrypted database, sealed originals and earlier versions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Datenbank, versiegelte Originale und frühere Versionen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυπτογραφημένη βάση δεδομένων, σφραγισμένα πρωτότυπα και προηγούμενες εκδόσεις"
          }
        },
        "es": {
