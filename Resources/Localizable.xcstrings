    "Writes %@ and hands them to the share sheet — Mail, WhatsApp, AirDrop, or Save to Files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt %@ und übergibt sie an das Teilen-Menü – Mail, WhatsApp, AirDrop oder „In Dateien sichern“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράφει %@ και τα παραδίδει στο μενού Κοινοποίησης — Mail, WhatsApp, AirDrop ή Αποθήκευση στα Αρχεία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe %@ y los pasa a la hoja para compartir: Mail, WhatsApp, AirDrop o Guardar en Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit %@ et les transmet à la feuille de partage — Mail, WhatsApp, AirDrop ou Enregistrer dans Fichiers."
