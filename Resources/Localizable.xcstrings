    "This person is gone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person existiert nicht mehr"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το άτομο δεν υπάρχει πια"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona ya no existe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne n'existe plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona non esiste più"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цієї особи більше немає"
          }
        }
      }
    },
    "This replaces everything with %@ as of %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird alles durch %@ mit Stand %@ ersetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αντικαθιστά τα πάντα με %@, όπως ήταν στις %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto lo sustituye todo por %@ tal como estaba el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace tout par %@ dans son état du %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione sostituisce tutto con %@ com'era il %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить усі дані версією, що містить %1$@, станом на %2$@."
          }
        }
      }
    },
    "This replaces what is on this Mac now with %@.\n\nWhat you have now is kept as another version first, so you can step back again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der aktuelle Inhalt dieses Mac durch %@ ersetzt.\n\nDer aktuelle Stand wird zuvor als weitere Version aufbewahrt, sodass Sie wieder zurückkehren können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αντικαθιστά ό,τι υπάρχει τώρα σε αυτό το Mac με %@.\n\nΌ,τι έχετε τώρα διατηρείται πρώτα ως άλλη έκδοση, ώστε να μπορείτε να επιστρέψετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye lo que hay ahora en este Mac por %@.\n\nLo que tienes ahora se guarda antes como otra versión, así que puedes volver atrás de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace ce qui se trouve actuellement sur ce Mac par %@.\n\nCe que vous avez maintenant est d'abord conservé comme une autre version, pour que vous puissiez revenir en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione sostituisce ciò che c'è ora su questo Mac con %@.\n\nCiò che hai ora viene prima conservato come un'altra versione, così puoi tornare indietro di nuovo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить поточні дані на цьому Mac версією, що містить %@.\n\nПоточний стан спершу буде збережено як ще одну версію, тож ви зможете повернутися назад."
          }
        }
      }
    },
    "This replaces what is on this Mac now with an earlier version.\n\nWhat you have now is kept as another version first, so you can step back again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der aktuelle Inhalt dieses Mac durch eine frühere Version ersetzt.\n\nDer aktuelle Stand wird zuvor als weitere Version aufbewahrt, sodass Sie wieder zurückkehren können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αντικαθιστά ό,τι υπάρχει τώρα σε αυτό το Mac με μια προηγούμενη έκδοση.\n\nΌ,τι έχετε τώρα διατηρείται πρώτα ως άλλη έκδοση, ώστε να μπορείτε να επιστρέψετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye lo que hay ahora en este Mac por una versión anterior.\n\nLo que tienes ahora se guarda antes como otra versión, así que puedes volver atrás de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace ce qui se trouve actuellement sur ce Mac par une version précédente.\n\nCe que vous avez maintenant est d'abord conservé comme une autre version, pour que vous puissiez revenir en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione sostituisce ciò che c'è ora su questo Mac con una versione precedente.\n\nCiò che hai ora viene prima conservato come un'altra versione, così puoi tornare indietro di nuovo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить поточні дані на цьому Mac попередньою версією.\n\nПоточний стан спершу буде збережено як ще одну версію, тож ви зможете повернутися назад."
          }
        }
      }
    },
    "This trip has no yacht.": {
      "localizations": {
