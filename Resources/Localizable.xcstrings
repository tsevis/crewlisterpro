          }
        }
      }
    },
    "Encrypted local data could not be decoded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte lokale Daten konnten nicht dekodiert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποκωδικοποίηση των κρυπτογραφημένων τοπικών δεδομένων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido descodificar los datos locales cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales chiffrées n'ont pas pu être décodées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decodificare i dati locali crittografati."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося декодувати зашифровані локальні дані."
          }
        }
      }
    },
    "Encrypted storage is unavailable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselter Speicher nicht verfügbar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κρυπτογραφημένος χώρος αποθήκευσης δεν είναι διαθέσιμος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento cifrado no está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage chiffré n'est pas disponible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archiviazione crittografata non è disponibile"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифроване сховище недоступне"
          }
        }
      }
    },
    "Erases this yacht, its %lld trips and their documents. Retire it instead to keep those crew lists.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Löscht diese Yacht, ihren %lld Törn und dessen Dokumente. Mustern Sie sie stattdessen aus, um diese Crewliste zu behalten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Löscht diese Yacht, ihre %lld Törns und deren Dokumente. Mustern Sie sie stattdessen aus, um diese Crewlisten zu behalten."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Σβήνει αυτό το σκάφος, το %lld ταξίδι του και τα έγγραφά του. Αποσύρετέ το για να κρατήσετε αυτή την κατάσταση πληρώματος."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Σβήνει αυτό το σκάφος, τα %lld ταξίδια του και τα έγγραφά τους. Αποσύρετέ το για να κρατήσετε αυτές τις καταστάσεις πληρώματος."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Erases this yacht, its %lld trip and its documents. Retire it instead to keep that crew list."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Erases this yacht, its %lld trips and their documents. Retire it instead to keep those crew lists."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Borra este yate, su %lld viaje y sus documentos. Retíralo para conservar esa lista de tripulantes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Borra este yate, sus %lld viajes y sus documentos. Retíralo para conservar esas listas de tripulantes."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Efface ce yacht, sa %lld croisière et ses documents. Retirez-le plutôt pour conserver cette liste d'équipage."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Efface ce yacht, ses %lld croisières et leurs documents. Retirez-le plutôt pour conserver ces listes d'équipage."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cancella questo yacht, il suo %lld viaggio e i relativi documenti. Ritiralo invece per conservare quella lista equipaggio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cancella questo yacht, i suoi %lld viaggi e i relativi documenti. Ritiralo invece per conservare quelle liste equipaggio."
                }
              }
            }
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирає цю яхту, її рейси (%lld) та їхні документи. Щоб зберегти ці списки екіпажу, натомість виведіть її з флоту."
          }
        }
      }
    },
    "Every crew-list field was confirmed against this scan on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Feld der Crewliste wurde am %@ anhand dieses Scans bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πεδίο της κατάστασης πληρώματος επιβεβαιώθηκε με αυτή τη σάρωση στις %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los campos de la lista de tripulantes se confirmaron con este escaneo el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque champ de la liste d'équipage a été confirmé d'après ce scan le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni campo della lista equipaggio è stato confermato rispetto a questa scansione il %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне поле списку екіпажу підтверджено за цим сканом %@."
          }
        }
      }
    },
    "Every export asks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Export fragt nach"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε εξαγωγή ρωτά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada exportación pregunta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exportation demande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esportazione chiede"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен експорт запитує"
          }
        }
      }
    },
    "Every field arrives unconfirmed. A crew list is still a document a person has looked at.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Feld kommt unbestätigt an. Eine Crewliste ist nach wie vor ein Dokument, das ein Mensch angesehen hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πεδίο φτάνει ανεπιβεβαίωτο. Η κατάσταση πληρώματος παραμένει ένα έγγραφο που έχει δει ένας άνθρωπος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los campos llegan sin confirmar. Una lista de tripulantes sigue siendo un documento que ha revisado una persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque champ arrive non confirmé. Une liste d'équipage reste un document qu'une personne a examiné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni campo arriva non confermato. Una lista equipaggio è pur sempre un documento che una persona ha esaminato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне поле надходить непідтвердженим. Список екіпажу — це й далі документ, який переглянула людина."
          }
        }
      }
    },
    "Every field has been confirmed against its document. The crew list can be written.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Feld wurde anhand seines Dokuments bestätigt. Die Crewliste kann geschrieben werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πεδίο έχει επιβεβαιωθεί με το έγγραφό του. Η κατάσταση πληρώματος μπορεί να γραφτεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los campos se han confirmado con su documento. Ya se puede escribir la lista de tripulantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque champ a été confirmé d'après son document. La liste d'équipage peut être écrite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni campo è stato confermato rispetto al suo documento. La lista equipaggio può essere scritta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне поле підтверджено за його документом. Список екіпажу можна записати."
          }
        }
      }
    },
    "Every field on every document has been confirmed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Feld in jedem Dokument wurde bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πεδίο σε κάθε έγγραφο έχει επιβεβαιωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han confirmado todos los campos de todos los documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque champ de chaque document a été confirmé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni campo di ogni documento è stato confermato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне поле кожного документа підтверджено."
          }
        }
      }
    },
    "Every field still arrives unconfirmed. Adding a passport to a charter is not reviewing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Feld kommt weiterhin unbestätigt an. Einen Pass zu einem Charter hinzuzufügen, heißt nicht, ihn zu prüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πεδίο εξακολουθεί να φτάνει ανεπιβεβαίωτο. Η προσθήκη ενός διαβατηρίου σε μια ναύλωση δεν είναι έλεγχός του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los campos siguen llegando sin confirmar. Añadir un pasaporte a un chárter no es revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque champ arrive toujours non confirmé. Ajouter un passeport à un charter ne revient pas à le vérifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni campo arriva comunque non confermato. Aggiungere un passaporto a un charter non significa verificarlo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне поле все одно надходить непідтвердженим. Додати паспорт до чартеру — не те саме, що перевірити його."
          }
        }
      }
    },
    "Every required field confirmed against the image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Pflichtfeld anhand des Bildes bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε υποχρεωτικό πεδίο επιβεβαιώθηκε με την εικόνα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los campos obligatorios confirmados con la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque champ obligatoire a été confirmé d'après l'image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni campo obbligatorio è confermato rispetto all'immagine."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне обов’язкове поле підтверджено за зображенням."
          }
        }
      }
    },
    "Every setting applies to this Mac. Nothing here leaves it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einstellung gilt für diesen Mac. Nichts hier verlässt ihn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ρύθμιση ισχύει για αυτό το Mac. Τίποτα από εδώ δεν φεύγει από αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes se aplican a este Mac. Nada de esto sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réglage s'applique à ce Mac. Rien ici n'en sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni impostazione si applica a questo Mac. Niente di ciò che è qui lo lascia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі параметри стосуються цього Mac. Ніщо звідси його не залишає."
          }
        }
      }
    },
