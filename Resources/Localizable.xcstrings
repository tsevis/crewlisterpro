    "%lld boats could not be read and were left out.": {
      "localizations": {
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld σκάφος δεν ήταν δυνατό να διαβαστεί και παραλείφθηκε."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld σκάφη δεν ήταν δυνατό να διαβαστούν και παραλείφθηκαν."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld boat could not be read and was left out."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld boats could not be read and were left out."
                }
