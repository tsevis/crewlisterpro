        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν από πάνω από 100 χρόνια — ελέγξτε τον αιώνα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace más de 100 años; revisa el siglo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus de 100 ans — vérifiez le siècle."
          }
        },
        "it": {
