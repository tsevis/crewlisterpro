    "GIVEN NAMES SURNAME": {
      "comment": "Placeholder showing the order to type a name in; the name itself is always typed in Latin letters.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VORNAMEN NACHNAME"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
