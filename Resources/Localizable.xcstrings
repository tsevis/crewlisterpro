          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NOMBRE APELLIDOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PRÉNOMS NOM"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NOMI COGNOME"
          }
        },
        "uk": {
          "stringUnit": {
