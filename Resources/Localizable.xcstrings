    "Editing the stored image keeps an encrypted revision and clears every confirmation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bearbeiten des gespeicherten Bildes bewahrt eine verschlüsselte Revision auf und hebt jede Bestätigung auf"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επεξεργασία της αποθηκευμένης εικόνας κρατά μια κρυπτογραφημένη αναθεώρηση και ακυρώνει κάθε επιβεβαίωση"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar la imagen guardada conserva una revisión cifrada y borra todas las confirmaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier l'image stockée conserve une révision chiffrée et efface toutes les confirmations"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica dell'immagine archiviata conserva una revisione crittografata e annulla tutte le conferme"
          }
        },
        "uk": {
