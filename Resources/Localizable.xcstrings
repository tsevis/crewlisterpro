            "state": "translated",
            "value": "Αυτό το σκάφος δεν υπάρχει πια"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este yate ya no existe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce yacht n'existe plus"
          }
        },
        "it": {
