            "state": "translated",
            "value": "Зберігати: %lld"
          }
        }
      }
    },
    "Keep %lld earlier versions": {
      "localizations": {
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Διατήρηση %lld προηγούμενης έκδοσης"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Διατήρηση %lld προηγούμενων εκδόσεων"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Keep %lld earlier version"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Keep %lld earlier versions"
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Зберігати %lld попередні версії"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Зберігати %lld попередніх версій"
                }
              },
              "one": {
                "stringUnit": {
