    "%@'s scan could not be read from the crew library, so they were not added: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan von %@ konnte nicht aus der Crew-Bibliothek gelesen werden, daher wurde die Person nicht hinzugefügt: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση για το άτομο %@ δεν ήταν δυνατό να διαβαστεί από τη βιβλιοθήκη πληρώματος, οπότε δεν προστέθηκε: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el escaneo de %@ en la Biblioteca de tripulantes, así que no se ha añadido: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan de %@ n'a pas pu être lu depuis la bibliothèque d'équipage ; cette personne n'a donc pas été ajoutée : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la scansione di %@ dalla libreria equipaggio, quindi non è stato aggiunto: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скан особи %1$@ не вдалося прочитати з бібліотеки екіпажу, тому її не додано: %2$@"
          }
        }
      }
    },
