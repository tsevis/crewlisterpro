    "Deleting erases the encrypted original and every revision of it from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen werden das verschlüsselte Original und jede seiner Revisionen von %@ gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή σβήνει το κρυπτογραφημένο πρωτότυπο και κάθε αναθεώρησή του από %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar se borran de %@ el original cifrado y todas sus revisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression efface l'original chiffré et chacune de ses révisions de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione cancella da %@ l'originale crittografato e ogni sua revisione."
