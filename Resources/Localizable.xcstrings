    "Choose a person on the left to see what was confirmed about them, and the scan it was confirmed against.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie links eine Person, um zu sehen, was über sie bestätigt wurde und anhand welchen Scans."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα άτομο στα αριστερά για να δείτε τι επιβεβαιώθηκε γι' αυτό και τη σάρωση με την οποία επιβεβαιώθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige a una persona a la izquierda para ver qué se ha confirmado sobre ella y el escaneo con el que se ha confirmado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une personne à gauche pour voir ce qui a été confirmé à son sujet et le scan sur lequel cela a été confirmé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una persona a sinistra per vedere cosa è stato confermato su di lei e la scansione su cui è stato confermato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть особу ліворуч, щоб побачити, що про неї підтверджено, і скан, за яким це звіряли."
          }
        }
      }
    },
    "Choose a trip from the picker in the command line above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Törn in der Auswahl in der Befehlsleiste oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα ταξίδι από τον επιλογέα στη γραμμή εντολών επάνω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un viaje en el selector de la barra de comandos de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une croisière dans le sélecteur de la barre de commandes ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un viaggio dal selettore nella riga di comando qui sopra."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть рейс у селекторі в командному рядку вгорі."
          }
        }
      }
    },
    "Choose a yacht on the left to check or correct what is printed on its crew lists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie links eine Yacht, um zu prüfen oder zu korrigieren, was auf ihren Crewlisten gedruckt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα σκάφος στα αριστερά για να ελέγξετε ή να διορθώσετε ό,τι τυπώνεται στις καταστάσεις πληρώματός του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un yate a la izquierda para revisar o corregir lo que se imprime en sus listas de tripulantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un yacht à gauche pour vérifier ou corriger ce qui est imprimé sur ses listes d'équipage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno yacht a sinistra per verificare o correggere ciò che viene stampato sulle sue liste equipaggio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть яхту ліворуч, щоб перевірити або виправити те, що друкується в її списках екіпажу."
          }
        }
      }
    },
    "Choose the charter they belong to.": {
