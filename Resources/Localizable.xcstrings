    },
    "This person is gone": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το άτομο δεν υπάρχει πια"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цієї особи більше немає"
          }
        }
      }
    },
    "This replaces everything with %@ as of %@.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αντικαθιστά τα πάντα με %@, όπως ήταν στις %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить усі дані версією, що містить %1$@, станом на %2$@."
          }
        }
      }
    },
    "This replaces what is on this Mac now with %@.\n\nWhat you have now is kept as another version first, so you can step back again.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αντικαθιστά ό,τι υπάρχει τώρα σε αυτό το Mac με %@.\n\nΌ,τι έχετε τώρα διατηρείται πρώτα ως άλλη έκδοση, ώστε να μπορείτε να επιστρέψετε ξανά."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить поточні дані на цьому Mac версією, що містить %@.\n\nПоточний стан спершу буде збережено як ще одну версію, тож ви зможете повернутися назад."
          }
        }
      }
    },
    "This replaces what is on this Mac now with an earlier version.\n\nWhat you have now is kept as another version first, so you can step back again.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αντικαθιστά ό,τι υπάρχει τώρα σε αυτό το Mac με μια προηγούμενη έκδοση.\n\nΌ,τι έχετε τώρα διατηρείται πρώτα ως άλλη έκδοση, ώστε να μπορείτε να επιστρέψετε ξανά."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить поточні дані на цьому Mac попередньою версією.\n\nПоточний стан спершу буде збережено як ще одну версію, тож ви зможете повернутися назад."
          }
        }
      }
    },
    "This trip has no yacht.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ταξίδι δεν έχει σκάφος."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цього рейсу немає яхти."
          }
        }
      }
    },
    "This trip's passports and scans are deleted on %@, %lld days after the crew list was first exported.": {
      "localizations": {
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Τα διαβατήρια και οι σαρώσεις αυτού του ταξιδιού διαγράφονται στις %@, %lld ημέρα μετά την πρώτη εξαγωγή της κατάστασης πληρώματος."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Τα διαβατήρια και οι σαρώσεις αυτού του ταξιδιού διαγράφονται στις %@, %lld ημέρες μετά την πρώτη εξαγωγή της κατάστασης πληρώματος."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This trip's passports and scans are deleted on %@, %lld day after the crew list was first exported."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This trip's passports and scans are deleted on %@, %lld days after the crew list was first exported."
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Паспорти й скани цього рейсу буде видалено %@ — через %lld дні після першого експорту списку екіпажу."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Паспорти й скани цього рейсу буде видалено %@ — через %lld днів після першого експорту списку екіпажу."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Паспорти й скани цього рейсу буде видалено %@ — через %lld день після першого експорту списку екіпажу."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Паспорти й скани цього рейсу буде видалено %@ — через %lld дня після першого експорту списку екіпажу."
                }
              }
            }
          }
        }
      }
    },
    "This yacht is gone": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το σκάφος δεν υπάρχει πια"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цієї яхти більше немає"
          }
        }
      }
    },
    "This yacht is on %lld charters holding %lld encrypted documents. Deleting it deletes those too, and cannot be undone.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το σκάφος συμμετέχει σε ναυλώσεις (%lld) με κρυπτογραφημένα έγγραφα (%lld). Η διαγραφή του τα διαγράφει κι αυτά και δεν αναιρείται."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця яхта бере участь у чартерах (%1$lld), де зберігаються зашифровані документи (%2$lld). Якщо видалити яхту, їх теж буде видалено, і це неможливо скасувати."
          }
        }
      }
    },
    "This yacht is on no charters.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το σκάφος δεν συμμετέχει σε καμία ναύλωση."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця яхта не бере участі в жодному чартері."
          }
        }
      }
    },
    "Thursday": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέμπτη"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Четвер"
          }
        }
      }
    },
    "Too short to be a name.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολύ σύντομο για όνομα."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надто коротко для імені."
          }
        }
      }
    },
    "Trip": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξίδι"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рейс"
          }
        }
      }
    },
    "Trip details": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στοιχεία ταξιδιού"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані рейсу"
          }
        }
      }
    },
    "Tuesday": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρίτη"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вівторок"
          }
        }
      }
    },
    "Type the fields from the image instead — the machine-readable zone on this document could not be read either.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε τα πεδία από την εικόνα — ούτε η ζώνη μηχανικής ανάγνωσης αυτού του εγγράφου διαβάστηκε."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натомість введіть поля із зображення — машинозчитувану зону цього документа теж не вдалося прочитати."
          }
        }
      }
    },
    "Union Yachting for the Greek charter community": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Union Yachting για την ελληνική κοινότητα ναύλωσης"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Union Yachting — для грецької чартерної спільноти"
          }
        }
      }
    },
    "Untitled yacht": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκάφος χωρίς όνομα"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яхта без назви"
          }
        }
      }
    },
    "Unusually short document number.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ασυνήθιστα σύντομος αριθμός εγγράφου."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незвично короткий номер документа."
          }
        }
      }
    },
    "Update in Crew Library": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωση στη βιβλιοθήκη πληρώματος"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновити в бібліотеці екіпажу"
          }
        }
      }
    },
    "Use M, F or X.": {
      "comment": "M, F and X are the letters typed; keep them as they are.",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε M, F ή X."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте M, F або X."
          }
        }
      }
    },
    "Use This Folder": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση αυτού του φακέλου"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використати цю папку"
          }
        }
      }
    },
    "Use a country name or 3-letter code.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε όνομα χώρας ή κωδικό 3 γραμμάτων."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте назву країни або 3-літерний код."
          }
        }
      }
    },
    "Use a date like 20 OCT 1972.": {
      "comment": "20 OCT 1972 is the exact form typed into the field; keep it in English.",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε ημερομηνία όπως 20 OCT 1972."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте дату у форматі 20 OCT 1972."
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έκδοση %@ (%@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Версія %@ (%@)"
          }
        }
      }
    },
    "Version saved": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση αποθηκεύτηκε"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Версію збережено"
          }
        }
      }
    },
    "Versions": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκδόσεις"
          }
        },
        "uk": {
