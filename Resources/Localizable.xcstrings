    "Editing the stored image keeps an encrypted revision and clears every confirmation": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επεξεργασία της αποθηκευμένης εικόνας κρατά μια κρυπτογραφημένη αναθεώρηση και ακυρώνει κάθε επιβεβαίωση"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагування збереженого зображення зберігає зашифровану редакцію й скасовує всі підтвердження"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "uk": {
