            "state": "translated",
            "value": "%@ з %@"
          }
        }
      }
    },
    "%@ was kept, but their scan could not be copied into the library: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde behalten, aber der Scan konnte nicht in die Bibliothek kopiert werden: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο %@ διατηρήθηκε, αλλά η σάρωσή του δεν ήταν δυνατό να αντιγραφεί στη βιβλιοθήκη: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha conservado a %@, pero su escaneo no se ha podido copiar en la biblioteca: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été conservé, mais son scan n'a pas pu être copié dans la bibliothèque : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato conservato, ma non è stato possibile copiarne la scansione nella libreria: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані особи %1$@ збережено, але її скан не вдалося скопіювати до бібліотеки: %2$@"
          }
        }
      }
    },
    "%@ was shared to CrewListr Pro but could not be read: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit CrewListr Pro geteilt, konnte aber nicht gelesen werden: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ κοινοποιήθηκε στο CrewListr Pro αλλά δεν ήταν δυνατό να διαβαστεί: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha compartido con CrewListr Pro, pero no se ha podido leer: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été partagé avec CrewListr Pro mais n'a pas pu être lu : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato condiviso con CrewListr Pro, ma non è stato possibile leggerlo: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %1$@ надіслано до CrewListr Pro, але його не вдалося прочитати: %2$@"
          }
        }
      }
    },
