      }
    },
    "Done": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τέλος"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Download %@": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити %@"
          }
        }
      }
    },
    "Download %@ (%@). It is a one-time download and stays on this Mac. Everything else works without it.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη %@ (%@). Είναι λήψη μίας φοράς και παραμένει σε αυτό το Mac. Όλα τα υπόλοιπα λειτουργούν χωρίς αυτό."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте %@ (%@). Це одноразове завантаження, яке залишається на цьому Mac. Усе інше працює без нього."
          }
        }
      }
    },
    "Download the local AI model?": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη του τοπικού μοντέλου ΤΝ;"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити локальну модель ШІ?"
          }
        }
      }
    },
    "Downloading the local AI model": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη του τοπικού μοντέλου ΤΝ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження локальної моделі ШІ"
          }
        }
      }
    },
    "Drag each crew member's passport onto this window, or import the photos and scans below. Everything stays encrypted on this Mac.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε το διαβατήριο κάθε μέλους του πληρώματος σε αυτό το παράθυρο ή εισαγάγετε τις φωτογραφίες και τις σαρώσεις παρακάτω. Όλα μένουν κρυπτογραφημένα σε αυτό το Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть паспорт кожного члена екіпажу на це вікно або імпортуйте фото й скани нижче. Усе зберігається в зашифрованому вигляді на цьому Mac."
          }
        }
      }
    },
    "Drag to reorder. A new charter takes the yacht you chartered last — there is deliberately no default yacht to keep in step with a fleet that changes.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για αλλαγή σειράς. Μια νέα ναύλωση παίρνει το σκάφος που ναυλώσατε τελευταίο — σκόπιμα δεν υπάρχει προεπιλεγμένο σκάφος που θα έπρεπε να συμβαδίζει με έναν στόλο που αλλάζει."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок. Новий чартер бере яхту, яку ви здавали в чартер востаннє, — типової яхти навмисно немає, бо її довелося б узгоджувати з флотом, що змінюється."
          }
        }
      }
    },
    "Drop passports here": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε εδώ διαβατήρια"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть паспорти сюди"
          }
        }
      }
    },
    "Duplicate": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργία διπλοτύπου"
          }
        },
        "uk": {
