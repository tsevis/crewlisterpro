    },
    "This yacht is on %lld charters holding %lld encrypted documents. Deleting it deletes those too, and cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Yacht ist auf %lld Chartern mit %lld verschlüsselten Dokumenten. Wird sie gelöscht, werden auch diese gelöscht; dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το σκάφος συμμετέχει σε ναυλώσεις (%lld) με κρυπτογραφημένα έγγραφα (%lld). Η διαγραφή του τα διαγράφει κι αυτά και δεν αναιρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este yate figura en %lld chárteres con %lld documentos cifrados. Eliminarlo los elimina también y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce yacht figure dans %lld charters contenant %lld documents chiffrés. Le supprimer les supprime aussi, et cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo yacht è in %lld charter che contengono %lld documenti crittografati. Eliminarlo elimina anche quelli e non può essere annullato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця яхта бере участь у чартерах (%1$lld), де зберігаються зашифровані документи (%2$lld). Якщо видалити яхту, їх теж буде видалено, і це неможливо скасувати."
          }
        }
      }
    },
    "This yacht is on no charters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Yacht ist auf keinem Charter."
