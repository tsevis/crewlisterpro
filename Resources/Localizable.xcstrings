    "Restoring snapshots the current state first, so it is undoable too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Wiederherstellen wird der aktuelle Stand gesichert, sodass auch dies rückgängig gemacht werden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επαναφορά κρατά πρώτα στιγμιότυπο της τρέχουσας κατάστασης, οπότε μπορεί κι αυτή να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de restaurar se guarda una instantánea del estado actual, así que también se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration enregistre d'abord l'état actuel, elle peut donc elle aussi être annulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino salva prima lo stato attuale, quindi anch'esso è annullabile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед відновленням поточний стан зберігається як знімок, тож відновлення теж можна скасувати."
          }
        }
      }
    },
