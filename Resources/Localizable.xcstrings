    "Removing someone erases the library's copy of their scan. An app that holds passport photographs has to be able to forget them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer jemanden entfernt, löscht die Kopie des Scans in der Bibliothek. Eine App, die Passfotos aufbewahrt, muss sie auch vergessen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αφαίρεση ενός ατόμου σβήνει το αντίγραφο της σάρωσής του που κρατά η βιβλιοθήκη. Μια εφαρμογή που κρατά φωτογραφίες διαβατηρίων πρέπει να μπορεί να τις ξεχνά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar a alguien borra la copia de su escaneo que guarda la biblioteca. Una app que guarda fotografías de pasaportes tiene que poder olvidarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer quelqu'un efface la copie de son scan conservée par la bibliothèque. Une app qui conserve des photos de passeport doit pouvoir les oublier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere qualcuno cancella la copia della sua scansione nella libreria. Un'app che conserva fotografie di passaporti deve poterle dimenticare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучення особи стирає бібліотечну копію її скану. Програма, що зберігає фото паспортів, має вміти їх забувати."
          }
        }
      }
    },
