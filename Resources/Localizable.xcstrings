    "Without the scan there is nothing on this screen to check these values against. Import the passport again before confirming them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne den Scan gibt es auf diesem Bildschirm nichts, womit sich diese Werte prüfen lassen. Importieren Sie den Pass erneut, bevor Sie sie bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς τη σάρωση δεν υπάρχει τίποτα σε αυτή την οθόνη για να ελεγχθούν αυτές οι τιμές. Εισαγάγετε ξανά το διαβατήριο πριν τις επιβεβαιώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin el escaneo, en esta pantalla no hay nada con lo que comprobar estos valores. Vuelve a importar el pasaporte antes de confirmarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans le scan, rien sur cet écran ne permet de vérifier ces valeurs. Importez à nouveau le passeport avant de les confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza la scansione, in questa schermata non c'è nulla con cui verificare questi valori. Importa di nuovo il passaporto prima di confermarli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без скану на цьому екрані немає з чим звірити ці значення. Імпортуйте паспорт знову, перш ніж їх підтверджувати."
          }
        }
      }
    },
    "Write %@ into %@ — set in Settings. Right-click to choose a different folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in %@ schreiben – festgelegt in den Einstellungen. Rechtsklicken, um einen anderen Ordner zu wählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράφει %@ στον φάκελο %@ — ορίζεται στις Ρυθμίσεις. Κάντε δεξί κλικ για να επιλέξετε άλλον φάκελο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe %@ en %@, definido en Ajustes. Haz clic con el botón derecho para elegir otra carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrire %@ dans %@ — défini dans Réglages. Clic droit pour choisir un autre dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi %@ in %@, impostata in Impostazioni. Fai clic con il tasto destro per scegliere un'altra cartella."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати файли (%1$@) у %2$@ — задано в Параметрах. Клацніть правою кнопкою, щоб вибрати іншу папку."
          }
        }
      }
    },
