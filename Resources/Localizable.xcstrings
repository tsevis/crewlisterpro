    "Download %@ (%@). It is a one-time download and stays on this Mac. Everything else works without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie %@ (%@). Es ist ein einmaliger Download und bleibt auf diesem Mac. Alles andere funktioniert ohne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη %@ (%@). Είναι λήψη μίας φοράς και παραμένει σε αυτό το Mac. Όλα τα υπόλοιπα λειτουργούν χωρίς αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga %@ (%@). Es una descarga única y se queda en este Mac. Todo lo demás funciona sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger %@ (%@). C'est un téléchargement unique qui reste sur ce Mac. Tout le reste fonctionne sans lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica %@ (%@). È un download da effettuare una sola volta e resta su questo Mac. Tutto il resto funziona senza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте %@ (%@). Це одноразове завантаження, яке залишається на цьому Mac. Усе інше працює без нього."
          }
        }
      }
    },
    "Download the local AI model?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales KI-Modell laden?"
          }
        },
        "el": {
