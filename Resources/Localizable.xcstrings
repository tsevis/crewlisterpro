    "It can take a minute on first use. Try again, and check there is free memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Mal kann es eine Minute dauern. Versuchen Sie es erneut und prüfen Sie, ob genügend Arbeitsspeicher frei ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να πάρει ένα λεπτό στην πρώτη χρήση. Δοκιμάστε ξανά και ελέγξτε ότι υπάρχει ελεύθερη μνήμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez puede tardar un minuto. Vuelve a intentarlo y comprueba que hay memoria libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut prendre une minute à la première utilisation. Réessayez et vérifiez qu'il reste de la mémoire libre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al primo utilizzo può richiedere un minuto. Riprova e verifica che ci sia memoria libera."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час першого використання це може тривати хвилину. Повторіть спробу й перевірте, чи є вільна пам’ять."
          }
        }
      }
    },
    "It was deleted or restored away while this screen was open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde gelöscht oder durch eine Wiederherstellung entfernt, während dieser Bildschirm geöffnet war."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφηκε ή αντικαταστάθηκε από επαναφορά όσο ήταν ανοιχτή αυτή η οθόνη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha eliminado o se ha restaurado otra versión mientras esta pantalla estaba abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été supprimé ou remplacé par une restauration pendant que cet écran était ouvert."
