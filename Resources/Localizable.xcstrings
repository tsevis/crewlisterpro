    "Documents · %lld of %lld cleared": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έγγραφα · %lld από %lld εγκεκριμένα"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Документи · допущено %lld з %lld"
          }
        }
      }
    },
    "Documents, extracted fields and the database never leave this machine.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα έγγραφα, τα πεδία που διαβάστηκαν και η βάση δεδομένων δεν φεύγουν ποτέ από αυτόν τον υπολογιστή."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Документи, розпізнані поля й база даних ніколи не залишають цей комп’ютер."
          }
        }
      }
    },
    "Doesn't look like an email address — check it.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μοιάζει με διεύθυνση email — ελέγξτε την."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не схоже на адресу е-пошти — перевірте."
          }
        }
      }
    },
    "Don't Show Again": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να μην εμφανιστεί ξανά"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не показувати"
          }
        }
      }
    },
    "Don't show again": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να μην εμφανιστεί ξανά"
          }
        },
