    "Documents, extracted fields and the database never leave this machine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumente, erkannte Felder und die Datenbank verlassen dieses Gerät nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα έγγραφα, τα πεδία που διαβάστηκαν και η βάση δεδομένων δεν φεύγουν ποτέ από αυτόν τον υπολογιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos, los campos extraídos y la base de datos nunca salen de este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents, les champs extraits et la base de données ne quittent jamais cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I documenti, i campi estratti e il database non lasciano mai questo computer."
          }
        },
        "uk": {
          "stringUnit": {
