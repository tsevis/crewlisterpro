    "Type the fields from the image instead — the machine-readable zone on this document could not be read either.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Felder stattdessen anhand des Bildes ein – auch die maschinenlesbare Zone dieses Dokuments konnte nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε τα πεδία από την εικόνα — ούτε η ζώνη μηχανικής ανάγνωσης αυτού του εγγράφου διαβάστηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe los campos a partir de la imagen: la zona de lectura mecánica de este documento tampoco se ha podido leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez plutôt les champs d'après l'image — la zone de lecture automatique de ce document n'a pas pu être lue non plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita invece i campi dall'immagine: anche la zona a lettura ottica di questo documento non può essere letta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натомість введіть поля із зображення — машинозчитувану зону цього документа теж не вдалося прочитати."
          }
        }
      }
    },
