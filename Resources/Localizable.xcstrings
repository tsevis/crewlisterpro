    "The crew list is not ready:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Crewliste ist nicht bereit:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάσταση πληρώματος δεν είναι έτοιμη:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de tripulantes no está lista:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste d'équipage n'est pas prête :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista equipaggio non è pronta:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список екіпажу не готовий:"
          }
        }
      }
    },
    "The crew list stays shut until every field on every document has been confirmed against the image it came from.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Crewliste bleibt gesperrt, bis jedes Feld in jedem Dokument anhand des Bildes bestätigt wurde, aus dem es stammt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάσταση πληρώματος μένει κλειστή μέχρι να επιβεβαιωθεί κάθε πεδίο σε κάθε έγγραφο με την εικόνα από την οποία προήλθε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de tripulantes sigue bloqueada hasta que todos los campos de todos los documentos se hayan confirmado con la imagen de la que proceden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste d'équipage reste bloquée tant que chaque champ de chaque document n'a pas été confirmé d'après l'image dont il provient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista equipaggio resta bloccata finché ogni campo di ogni documento non è stato confermato rispetto all'immagine da cui proviene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список екіпажу закритий, доки кожне поле кожного документа не буде підтверджено за зображенням, з якого його взято."
          }
        }
      }
    },
    "The crew list will be exported with the skipper section blank.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Crewliste wird mit leerem Skipper-Abschnitt exportiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάσταση πληρώματος θα εξαχθεί με κενό το τμήμα του κυβερνήτη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de tripulantes se exportará con la sección del patrón en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste d'équipage sera exportée avec la section skipper vide."
          }
        },
        "it": {
